@output json { pretty = true; indent = 4; }
@output_path "./example_06.json";

type Age = int [range=0..=100];
type HouseNumber = extend Age with [multiple_of=2];

template User {
    id = int[range=1..=1024];
    name = string;
    password = string;
    age = Age;
    balance = float;
    home_number = HouseNumber;
}

@generate User[10];
