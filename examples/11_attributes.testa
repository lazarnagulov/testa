@output csv;
@output_path "example11.csv";

#[private]
type Age = int [range=18..=36]; 

#[public]
enum Role { Guest => 7; Member => 5; Moderator => 2; Admin; }

#[abstract]
template BaseUser {
    #[primary_key]
    id = string_pattern "ID_${#[3]}";
    role = Role;
}

template User : BaseUser {
    #[required]
    name = string_pattern "${Aa[1..=15]}";
    
    #[required]
    #[nullable]
    nickname = string;

    #[required]
    age = Age;
}

@generate User[10];