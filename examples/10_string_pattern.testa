@output csv;
@output_path "./example10.csv";

template User {
    id = "ID_" + string_pattern "${#[5]}";
    name = string_pattern "${A}" + string;
    birth_year = int[range=1900..=2025];
    email = string_pattern "${a[1..=5]A[0..=2]#[0..=2]}@${a[1..=5]}.com";
    salary = string_pattern "$1.${#[3]},${#[2]}";
}

@generate User[10];