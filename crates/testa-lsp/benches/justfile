SIZES := "1000 10000 50000 100000 150000"

default: bench

fixtures:
    @mkdir -p benches/fixtures
    @for size in {{SIZES}}; do \
        echo "Generating fixture with $size lines..."; \
        python3 generator.py --lines $size --output benches/fixtures/fixture_$size.testa; \
    done

bench: fixtures
    cargo bench --bench lsp_performance

clean:
    rm -rf benches/fixtures/*.testa